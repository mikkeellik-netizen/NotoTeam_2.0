# ─── База данных ──────────────────────────────────────────────
POSTGRES_USER=kanban_user
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=kanban_db
DATABASE_URL=postgresql://kanban_user:your_strong_password_here@localhost:5432/kanban_db

# ─── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=your_redis_password_here
REDIS_URL=redis://:your_redis_password_here@localhost:6379

# ─── Telegram ─────────────────────────────────────────────────
BOT_TOKEN=1234567890:ABCDEFabcdef_your_bot_token_here
WEBAPP_URL=https://your-domain.com

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=your_very_long_random_secret_string_here_min_32_chars

# ─── Приложение ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
