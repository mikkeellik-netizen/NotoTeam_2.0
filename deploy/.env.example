# Public domain without https://. The A/AAAA record must point to this server.
APP_DOMAIN=app.example.com
TZ=Europe/Moscow

# Telegram bot token from @BotFather.
BOT_TOKEN=123456789:replace_me

# Numeric Telegram IDs with access to the product-owner system panel.
APP_OWNER_TELEGRAM_IDS=123456789

# Generate each secret independently: openssl rand -hex 32
INTERNAL_API_TOKEN=replace_with_64_random_hex_characters
EXTERNAL_CALENDAR_CREDENTIALS_SECRET=replace_with_another_64_random_hex_characters
SYSTEM_STATS_PSEUDONYM_SECRET=replace_with_another_64_random_hex_characters

# Local project file storage. Switch to s3 later without rebuilding the app.
FILE_STORAGE=local
PROJECT_FILE_MAX_BYTES=26214400
API_MAX_BODY_BYTES=41943040

# Fill these only when FILE_STORAGE=s3.
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=project-files
S3_FORCE_PATH_STYLE=false

# Local CPU speech recognition. "small" is the recommended quality/speed balance.
# Use "base" on a server with only 2-4 GB RAM, or "medium" on a stronger server.
SPEECH_MODEL=small
SPEECH_LANGUAGE=ru
SPEECH_CPU_THREADS=2
SPEECH_MAX_CONCURRENT=1
SPEECH_MEMORY_LIMIT=3g
SPEECH_TRANSCRIPTION_TIMEOUT_MS=180000

# Anti-abuse limits for Telegram voice messages.
VOICE_MAX_DURATION_SECONDS=120
VOICE_MAX_FILE_BYTES=20971520
VOICE_RATE_WINDOW_MS=600000
VOICE_RATE_MAX=5
VOICE_MAX_CONCURRENT=2
