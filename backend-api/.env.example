PORT=8787
CORS_ORIGIN=http://127.0.0.1:5174
BOT_TOKEN=123456:telegram-bot-token
# Public HTTPS address of the Telegram Mini App. Enables the button in calendar reminders.
TELEGRAM_WEB_APP_URL=https://app.example.com
# Calendar reminder worker settings.
CALENDAR_NOTIFICATION_INTERVAL_MS=15000
CALENDAR_NOTIFICATION_RETRY_MS=60000
CALENDAR_NOTIFICATION_MAX_ATTEMPTS=5
CALENDAR_NOTIFICATION_BATCH_SIZE=50
CALENDAR_NOTIFICATION_STALE_AFTER_MS=900000
# Private iCal links are encrypted with this secret before storage. Use 32+ random characters in production.
EXTERNAL_CALENDAR_CREDENTIALS_SECRET=replace-with-long-random-calendar-secret
EXTERNAL_CALENDAR_SYNC_INTERVAL_MS=900000
EXTERNAL_CALENDAR_FETCH_TIMEOUT_MS=12000
EXTERNAL_CALENDAR_MAX_BYTES=5242880
INTERNAL_API_TOKEN=replace-with-long-random-shared-secret
# Comma-separated numeric Telegram IDs allowed to open the product-owner system panel.
APP_OWNER_TELEGRAM_IDS=123456789
# Local-only preview for the built-in Local User. Ignored in production.
LOCAL_DEV_LOGIN=0
LOCAL_DEV_SYSTEM_OWNER=0
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400
AUTH_CODE_REQUEST_WINDOW_MS=60000
AUTH_CODE_REQUEST_MAX=3
AUTH_CODE_REQUEST_MAX_PER_IP=30
AUTH_CODE_VERIFY_WINDOW_MS=60000
AUTH_CODE_VERIFY_MAX=20
AUTH_CODE_VERIFY_MAX_PER_IP=100
# Number of wrong entries allowed for one issued code before it is invalidated.
AUTH_CODE_MAX_ATTEMPTS=5
# Temporary authentication IP block after the per-IP limit is exceeded (15 minutes).
AUTH_IP_BLOCK_MS=900000
API_MAX_BODY_BYTES=5242880
REQUEST_METRIC_LIMIT=5000
# Optional dedicated HMAC secret for stable anonymized project references in system stats.
SYSTEM_STATS_PSEUDONYM_SECRET=replace-with-long-random-secret
APP_DATA_DIR=../app-data
WORKSPACE_NORMALIZED_TABLES=primary

# Project files. Keep local until an S3-compatible service is configured.
FILE_STORAGE=local
PROJECT_FILE_MAX_BYTES=26214400

# Required only when FILE_STORAGE=s3.
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=private-project-files
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace-with-storage-access-key
S3_SECRET_ACCESS_KEY=replace-with-storage-secret-key
S3_PREFIX=project-files
S3_FORCE_PATH_STYLE=false
