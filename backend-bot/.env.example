BOT_TOKEN=123456:telegram-bot-token
INTERNAL_API_TOKEN=replace-with-long-random-shared-secret
# Public HTTPS root of the Mini App. Never use localhost or an API-only domain in production.
WEBAPP_URL=https://app.your-domain.example
WORKSPACE_API_URL=http://127.0.0.1:8787
BOT_MODE=polling
BOT_TIMEZONE=Europe/Moscow

# Local speech service. In Docker Compose this is the internal service URL.
SPEECH_TO_TEXT_URL=http://127.0.0.1:8000
SPEECH_TRANSCRIPTION_TIMEOUT_MS=180000

# Soft anti-abuse limits for voice messages.
VOICE_MAX_DURATION_SECONDS=120
VOICE_MAX_FILE_BYTES=20971520
VOICE_RATE_WINDOW_MS=600000
VOICE_RATE_MAX=5
VOICE_MAX_CONCURRENT=2
