{
  "name": "NotoTeam development",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [5175],
  "portsAttributes": {
    "5175": {
      "label": "NotoTeam frontend",
      "onAutoForward": "openPreview",
      "visibility": "private"
    }
  },
  "postCreateCommand": "npm --prefix frontend ci && npm --prefix backend-api ci && npm --prefix backend-bot ci",
  "postStartCommand": "bash .devcontainer/start.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
